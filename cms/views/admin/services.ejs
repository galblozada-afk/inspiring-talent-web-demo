<%- include('../partials/admin-top', { pageTitle: 'Servicios', active: 'services' }) %>
<%- include('../partials/admin-topline', { h1: 'Servicios', email: email, flash: flash }) %>

<% tabs.forEach(function(tab){ %>
<div class="card">
  <h2><%= tab.number_label %> · <%= tab.tab_label %></h2>
  <p class="hint">Clave interna: <code><%= tab.tab_key %></code> (no editable, controla la pestaña en el sitio).</p>

  <form method="POST" action="/admin/services/<%= tab.tab_key %>" enctype="multipart/form-data">
    <div class="row">
      <div>
        <label>Número (ej. 01)</label>
        <input type="text" name="number_label" value="<%= tab.number_label %>">
      </div>
      <div>
        <label>Nombre de la pestaña</label>
        <input type="text" name="tab_label" value="<%= tab.tab_label %>" required>
      </div>
    </div>

    <label>Título (h3)</label>
    <input type="text" name="heading" value="<%= tab.heading %>" required>

    <label>Descripción</label>
    <textarea name="description" rows="3"><%= tab.description %></textarea>

    <label>Contenido adicional (HTML — listas, tarjetas, etc.)</label>
    <div class="admin-section-label">Puntos y programas</div>
    <p class="help-block">Escribe un punto por renglón. El sitio dará formato automáticamente; no necesitas usar código.</p>
    <% [0, 1].forEach(function(index){ const group = tab.editorGroups[index]; %>
      <div class="content-group-editor">
        <label>Título del grupo <%= index + 1 %></label>
        <input type="text" name="group_<%= index + 1 %>_title" value="<%= group.title %>" placeholder="Ej. Bootcamps y talleres">
        <label>Elementos del grupo <%= index + 1 %></label>
        <textarea name="group_<%= index + 1 %>_items" rows="5" placeholder="Un elemento por renglón"><%= group.items %></textarea>
      </div>
    <% }) %>
    <p class="help-block">Puedes usar HTML. Por defecto trae las listas / tarjetas originales de esta pestaña — edítalas con cuidado si no conoces HTML.</p>

    <div class="row" style="margin-top:6px;">
      <div>
        <label>Imagen principal</label>
        <% if (tab.media_image) { %><img src="<%= tab.media_image %>" style="max-width:100%;border-radius:8px;margin-bottom:8px;"><% } %>
        <input type="file" name="media_image" accept="image/*">
      </div>
      <div>
        <label>Imagen insignia (opcional, solo aparece en algunas pestañas)</label>
        <% if (tab.media_badge_image) { %><img src="<%= tab.media_badge_image %>" style="max-width:100%;border-radius:8px;margin-bottom:8px;"><% } %>
        <input type="file" name="media_badge_image" accept="image/*">
      </div>
    </div>

    <button class="btn" type="submit" style="margin-top:18px;">Guardar "<%= tab.tab_label %>"</button>
  </form>
</div>
<% }) %>

<%- include('../partials/admin-bottom') %>
