<%- include('../partials/admin-top', { pageTitle: page ? 'Editar página' : 'Nueva página', active: 'pages' }) %>
<%- include('../partials/admin-topline', { h1: page ? 'Editar página' : 'Nueva página', email: email, flash: flash }) %>
<% const blocks = page && page.blocks ? page.blocks : []; %>
<form class="card page-builder" method="POST" action="<%= page ? '/admin/pages/' + page.id + '/edit' : '/admin/pages/new' %>" enctype="multipart/form-data">
  <div class="builder-note"><strong>Elige una estructura, escribe y publica.</strong><span>La plataforma adapta tu contenido al diseño de Inspiring Talent. No necesitas tocar código.</span></div>
  <div class="row"><div><label>Nombre de la página</label><input type="text" name="title" required value="<%= page ? page.title : '' %>" placeholder="Ej. Certificación en Coaching de Equipos"></div><div><label>Texto que verá la gente en el menú</label><input type="text" name="menu_label" value="<%= page ? page.menu_label : '' %>" placeholder="Ej. Certificación"></div></div>
  <div class="row"><div><label>Tipo de página</label><select name="layout"><option value="program" <%= page && page.layout === 'program' ? 'selected' : '' %>>Programa o servicio</option><option value="event" <%= page && page.layout === 'event' ? 'selected' : '' %>>Evento</option><option value="story" <%= page && page.layout === 'story' ? 'selected' : '' %>>Historia o campaña</option></select></div><div><label>Publicación</label><select name="status"><option value="draft" <%= (!page || page.status === 'draft') ? 'selected' : '' %>>Guardar como borrador</option><option value="published" <%= page && page.status === 'published' ? 'selected' : '' %>>Publicar página</option></select></div></div>
  <label class="admin-toggle"><input type="checkbox" name="show_in_menu" value="yes" <%= page && page.show_in_menu ? 'checked' : '' %>> Mostrar en el menú cinético</label>
  <label>Texto pequeño sobre el título</label><input type="text" name="eyebrow" value="<%= page ? page.eyebrow : '' %>" placeholder="Ej. Agenda Inspiring Talent">
  <label>Introducción</label><textarea name="intro" rows="4" placeholder="Explica en pocas líneas qué ofrece esta página y para quién es."><%= page ? page.intro : '' %></textarea>
  <label>Imagen de portada</label><% if (page && page.image) { %><img class="admin-preview-image" src="<%= page.image %>" alt=""><% } %><input type="file" name="image" accept="image/*"><p class="help-block">Usa una imagen horizontal clara, preferentemente 1600 × 900 px o mayor.</p>
  <div class="admin-section-label">Tres ideas clave</div><p class="help-block">Puedes dejar alguna vacía. La página acomoda automáticamente las que uses.</p>
  <% [0,1,2].forEach(function(index){ const block = blocks[index] || {}; %><div class="page-block-editor"><label>Idea <%= index + 1 %></label><input type="text" name="block_<%= index + 1 %>_title" value="<%= block.title || '' %>" placeholder="Título de la idea"><textarea name="block_<%= index + 1 %>_text" rows="3" placeholder="Descripción breve"><%= block.text || '' %></textarea></div><% }) %>
  <div class="row"><div><label>Texto del botón</label><input type="text" name="cta_label" value="<%= page ? page.cta_label : 'Hablemos' %>"></div><div><label>Destino del botón</label><input type="text" name="cta_href" value="<%= page ? page.cta_href : '/contacto' %>" placeholder="/contacto"></div></div>
  <button class="btn mint" type="submit" style="margin-top:18px"><%= page ? 'Guardar cambios' : 'Crear página' %></button><a class="btn ghost" href="/admin/pages" style="margin-top:18px">Cancelar</a>
</form>
<%- include('../partials/admin-bottom') %>
