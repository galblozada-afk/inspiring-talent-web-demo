<%- include('../partials/admin-top', { pageTitle: 'Solicitudes de contacto', active: 'contacts' }) %>
<%- include('../partials/admin-topline', { h1: 'Solicitudes de contacto', email: email, flash: flash }) %>

<div class="card">
  <div style="display:flex;justify-content:space-between;align-items:end;gap:16px;flex-wrap:wrap;margin-bottom:18px;">
    <div><h2 style="margin:0;">Conversaciones por iniciar</h2><p class="hint" style="margin:6px 0 0;">Cada formulario enviado desde la página de contacto aparece aquí.</p></div>
    <span class="hint"><%= contacts.length %> solicitud<%= contacts.length === 1 ? '' : 'es' %></span>
  </div>

  <% if (!contacts.length) { %>
    <p class="hint">Aún no hay solicitudes. Las nuevas consultas aparecerán aquí como “Nueva”.</p>
  <% } else { %>
    <div style="display:grid;gap:14px;">
      <% contacts.forEach(function(contact) { %>
        <article style="padding:19px;border:1px solid #dce4ef;border-radius:12px;background:#fff;">
          <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:16px;flex-wrap:wrap;">
            <div>
              <h3 style="margin:0 0 4px;"><%= contact.name %></h3>
              <p class="hint" style="margin:0;"><%= contact.company || 'Empresa no indicada' %> · <%= contact.service %></p>
            </div>
            <form action="/admin/contacts/<%= contact.id %>/status" method="post" style="display:flex;gap:8px;align-items:center;">
              <label class="sr-only" for="contact-status-<%= contact.id %>">Estado de <%= contact.name %></label>
              <select id="contact-status-<%= contact.id %>" name="status" style="margin:0;min-width:145px;">
                <option value="new" <%= contact.status === 'new' ? 'selected' : '' %>>Nueva</option>
                <option value="in_progress" <%= contact.status === 'in_progress' ? 'selected' : '' %>>En seguimiento</option>
                <option value="done" <%= contact.status === 'done' ? 'selected' : '' %>>Atendida</option>
              </select>
              <button class="btn ghost small" type="submit">Guardar</button>
            </form>
          </div>
          <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px 24px;margin:16px 0;color:#405169;font-size:14px;">
            <p style="margin:0;"><strong>Correo:</strong> <a href="mailto:<%= contact.email %>"><%= contact.email %></a></p>
            <p style="margin:0;"><strong>Teléfono:</strong> <%= contact.phone || 'No indicado' %></p>
            <p style="margin:0;"><strong>Newsletter:</strong> <%= contact.newsletter_opt_in ? 'Sí, desea recibir ideas.' : 'No seleccionado' %></p>
            <p style="margin:0;"><strong>Recibida:</strong> <%= new Date(contact.created_at).toLocaleString('es-MX', { dateStyle: 'medium', timeStyle: 'short' }) %></p>
          </div>
          <% if (contact.message) { %><p style="margin:0;padding-top:14px;border-top:1px solid #e5ebf3;line-height:1.6;"><strong>Necesidad del equipo:</strong><br><%= contact.message %></p><% } %>
        </article>
      <% }); %>
    </div>
  <% } %>
</div>

<style>.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}@media(max-width:650px){.card article>div:nth-child(2){grid-template-columns:1fr!important}}</style>
<%- include('../partials/admin-bottom') %>
