<!DOCTYPE html>
<html lang="es-MX">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" type="image/png" href="/assets/img/favicon-inspiring.png">
  <link rel="apple-touch-icon" href="/assets/img/favicon-inspiring.png">
  <title>Evaluación de Talento — InspiringTalent®</title>
  <meta name="description" content="Evaluaciones de talento que convierten información sobre comportamiento, competencias y desempeño en decisiones de desarrollo más claras.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Anton&family=Archivo+Black&family=Inter:wght@400;500;600;700&family=Montserrat:wght@500;600;700;800&display=swap" rel="stylesheet">
