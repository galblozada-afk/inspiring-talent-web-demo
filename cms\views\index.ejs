  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/CustomEase.min.js"></script>
  <script>

    // header shadow on scroll
    const header = document.getElementById('siteHeader');
    window.addEventListener('scroll', () => {
      header.classList.toggle('scrolled', window.scrollY > 8);
    });

    // reveal on scroll
    const revealEls = document.querySelectorAll('[data-reveal]');
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } });
      }, { threshold: .15 });
      revealEls.forEach(el => io.observe(el));
    } else {
      revealEls.forEach(el => el.classList.add('is-in'));
    }

    // section titles: reveal word by word as visitors reach each section
    const scrollTitles = document.querySelectorAll('.section-head h2');
    const reduceTitleMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    function prepareScrollTitle(title) {
      const words = title.textContent.trim().split(/\s+/);
      title.textContent = '';
      words.forEach((word, index) => {
        const wordEl = document.createElement('span');
        wordEl.className = 'scroll-title-word';
        wordEl.style.setProperty('--title-delay', `${index * 38}ms`);
        wordEl.textContent = word;
        title.appendChild(wordEl);
        if (index < words.length - 1) title.appendChild(document.createTextNode(' '));
      });
      title.classList.add('scroll-title');
    }
    scrollTitles.forEach(prepareScrollTitle);
    if (reduceTitleMotion || !('IntersectionObserver' in window)) {
      scrollTitles.forEach(title => title.classList.add('is-title-in'));
    } else {
      const titleObserver = new IntersectionObserver(entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-title-in');
            titleObserver.unobserve(entry.target);
          }
        });
      }, { threshold: .28, rootMargin: '0px 0px -6%' });
      scrollTitles.forEach(title => titleObserver.observe(title));
    }

    // hero word cycle
    const words = <%- JSON.stringify(heroText.cycle_words && heroText.cycle_words.length ? heroText.cycle_words : ['']) %>;
    let wi = 0;
    const cycleEl = document.getElementById('cycleWord');
    if (cycleEl && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      setInterval(() => {
        wi = (wi + 1) % words.length;
        cycleEl.style.opacity = 0;
        setTimeout(() => { cycleEl.textContent = words[wi]; cycleEl.style.opacity = 1; }, 220);
      }, 2600);
      cycleEl.style.transition = 'opacity .22s ease';
    }

    // hero: rotación de los 3 videos de fondo con crossfade
    (function () {
      const host = document.getElementById('heroVideoBg');
      if (!host) return;
      const vids = Array.from(host.querySelectorAll('video'));
      if (vids.length < 2) return;
      let idx = 0;
      const HOLD_MS = 8000; // tiempo que se muestra cada video antes de cruzar al siguiente

      vids[0].play().catch(() => { });

      function next() {
        const current = vids[idx];
        idx = (idx + 1) % vids.length;
        const upcoming = vids[idx];
        upcoming.currentTime = 0;
        upcoming.play().catch(() => { });
        upcoming.classList.add('is-active');
        current.classList.remove('is-active');
        setTimeout(() => { try { current.pause(); } catch (e) { } }, 1200);
      }
      setInterval(next, HOLD_MS);
    })();

    // agenda: carrusel de eventos publicado desde el panel de administración
    (function () {
      const eventCarousel = document.querySelector('[data-event-carousel]');
      if (!eventCarousel) return;

      const slides = Array.from(eventCarousel.querySelectorAll('[data-event-slide]'));
      if (slides.length < 2) return;

      const dots = Array.from(eventCarousel.querySelectorAll('[data-event-index]'));
      const previous = eventCarousel.querySelector('.event-carousel-prev');
      const next = eventCarousel.querySelector('.event-carousel-next');
      const toggle = eventCarousel.querySelector('.event-carousel-toggle');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let activeIndex = 0;
      let userPaused = false;
      let eventCarouselTimer = null;

      function showEvent(index) {
        activeIndex = (index + slides.length) % slides.length;
        slides.forEach((slide, slideIndex) => {
          const isActive = slideIndex === activeIndex;
          slide.classList.toggle('is-active', isActive);
          slide.setAttribute('aria-hidden', String(!isActive));
          slide.querySelectorAll('a').forEach(link => link.tabIndex = isActive ? 0 : -1);
        });
        dots.forEach((dot, dotIndex) => {
          const isActive = dotIndex === activeIndex;
          dot.classList.toggle('is-active', isActive);
          dot.setAttribute('aria-selected', String(isActive));
        });
      }

      function stopEventAutoplay() {
        if (eventCarouselTimer) clearInterval(eventCarouselTimer);
        eventCarouselTimer = null;
      }

      function startEventAutoplay() {
        stopEventAutoplay();
        if (reduceMotion || userPaused) return;
        eventCarouselTimer = setInterval(() => showEvent(activeIndex + 1), 5000);
      }

      function selectEvent(index) {
        userPaused = true;
        stopEventAutoplay();
        showEvent(index);
        toggle.setAttribute('aria-pressed', 'true');
        toggle.setAttribute('aria-label', 'Reanudar rotación');
        toggle.querySelector('span').textContent = '▶';
      }

      previous.addEventListener('click', () => selectEvent(activeIndex - 1));
      next.addEventListener('click', () => selectEvent(activeIndex + 1));
      dots.forEach(dot => dot.addEventListener('click', () => selectEvent(Number(dot.dataset.eventIndex))));
      toggle.addEventListener('click', () => {
        userPaused = !userPaused;
        if (userPaused) {
          stopEventAutoplay();
          toggle.setAttribute('aria-pressed', 'true');
          toggle.setAttribute('aria-label', 'Reanudar rotación');
          toggle.querySelector('span').textContent = '▶';
        } else {
          toggle.setAttribute('aria-pressed', 'false');
          toggle.setAttribute('aria-label', 'Pausar rotación');
          toggle.querySelector('span').textContent = 'Ⅱ';
          startEventAutoplay();
        }
      });

      eventCarousel.addEventListener('mouseenter', stopEventAutoplay);
      eventCarousel.addEventListener('mouseleave', startEventAutoplay);
      eventCarousel.addEventListener('focusin', stopEventAutoplay);
      eventCarousel.addEventListener('focusout', event => {
        if (!eventCarousel.contains(event.relatedTarget)) startEventAutoplay();
      });

      showEvent(0);
      startEventAutoplay();
    })();

    // service tabs
    const tabs = document.querySelectorAll('.svc-tab');
    const panels = document.querySelectorAll('.svc-panel');
    function activateServiceTab(name) {
      tabs.forEach(t => {
        const isActive = t.dataset.tab === name;
        t.classList.toggle('active', isActive);
        t.setAttribute('aria-selected', String(isActive));
      });
      panels.forEach(p => {
        const isActive = p.id === 'panel-' + name;
        p.classList.toggle('active', isActive);
        p.setAttribute('aria-hidden', String(!isActive));
      });
    }
    tabs.forEach(tab => tab.addEventListener('click', () => activateServiceTab(tab.dataset.tab)));

    // experience metrics: count once when the band enters the viewport
    const statsGrid = document.querySelector('.stats-grid');
    function animateStats() {
      if (!statsGrid || statsGrid.dataset.counted === 'true') return;
      statsGrid.dataset.counted = 'true';
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const duration = 1150;
      statsGrid.querySelectorAll('.stat-number').forEach(numberEl => {
        const target = Number(numberEl.dataset.countTo || 0);
        const suffix = numberEl.dataset.suffix || '';
        if (reduceMotion) {
          numberEl.textContent = target + suffix;
          return;
        }
        numberEl.textContent = '0' + suffix;
        const start = performance.now();
        function count(now) {
          const progress = Math.min((now - start) / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          numberEl.textContent = Math.round(target * eased) + suffix;
          if (progress < 1) requestAnimationFrame(count);
        }
        requestAnimationFrame(count);
      });
      statsGrid.querySelectorAll('.stat').forEach(stat => stat.classList.add('is-counted'));
    }
    if (statsGrid) {
      if ('IntersectionObserver' in window) {
        const statsObserver = new IntersectionObserver(entries => {
          if (entries[0].isIntersecting) { animateStats(); statsObserver.disconnect(); }
        }, { threshold: .35 });
        statsObserver.observe(statsGrid);
      } else {
        animateStats();
      }
    }

    // evaluation tools: supplied marks on the front, descriptions on a tap-friendly flip side
    const toolLogos = {
      'DISC': '/assets/img/assessment-tools/disc.png',
      'INTELIGENCIA EMOCIONAL': '/assets/img/assessment-tools/eq.png',
      'TALENT ALIGNMENT': '/assets/img/assessment-tools/talent-alignment.png',
      'AXES 360': '/assets/img/assessment-tools/axes-360.png'
    };
    const evaluationToolCards = document.querySelectorAll('.tool-card');
    function setToolCardState(card, isFlipped) {
      card.classList.toggle('is-flipped', isFlipped);
      card.setAttribute('aria-expanded', String(isFlipped));
    }
    evaluationToolCards.forEach(card => {
      const heading = card.querySelector('h5');
      const description = card.querySelector('p');
      const title = heading && heading.textContent.trim();
      const logo = toolLogos[title.toUpperCase()];
      if (!heading || !description || !logo) return;

      const inner = document.createElement('div');
      inner.className = 'tool-card-inner';
      const front = document.createElement('div');
      front.className = 'tool-card-face tool-card-face--front';
      const logoImg = document.createElement('img');
      logoImg.className = 'tool-card-logo';
      logoImg.classList.add(`tool-card-logo--${title.toLowerCase().replace(/\s+/g, '-')}`);
      logoImg.src = logo;
      logoImg.alt = '';
      const hint = document.createElement('span');
      hint.className = 'tool-card-hint';
      hint.textContent = 'Toca para conocer';
      front.append(logoImg, heading, hint);

      const back = document.createElement('div');
      back.className = 'tool-card-face tool-card-face--back';
      const backLabel = document.createElement('span');
      backLabel.className = 'tool-card-back-label';
      backLabel.textContent = title;
      const returnHint = document.createElement('span');
      returnHint.className = 'tool-card-hint';
      returnHint.textContent = 'Toca para volver';
      back.append(backLabel, description, returnHint);
      inner.append(front, back);
      card.replaceChildren(inner);
      card.classList.add('is-interactive');
      card.setAttribute('role', 'button');
      card.setAttribute('tabindex', '0');
      card.setAttribute('aria-label', `Conocer ${title}`);
      card.setAttribute('aria-expanded', 'false');
      const toggle = () => {
        const willFlip = !card.classList.contains('is-flipped');
        evaluationToolCards.forEach(otherCard => { if (otherCard !== card) setToolCardState(otherCard, false); });
        setToolCardState(card, willFlip);
      };
      card.addEventListener('click', toggle);
      card.addEventListener('keydown', event => {
        if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); toggle(); }
      });
    });

    // duplicate marquee track for seamless loop
    const track = document.getElementById('marqueeTrack');
    track.innerHTML += track.innerHTML;

    /* ============================================================
       TESTIMONIOS — carrusel circular, traducido de React+framer-motion
       a JS vanilla (referencia: circular-testimonials)
       ============================================================ */
    (function () {
      const data = [
        {
          name: 'Rita María Culebro Gómez',
          role: 'Directora General en POINT Potencializando Talentos',
          quote: 'Viví un proceso profundo de autoconocimiento que impactó positivamente mi vida personal y profesional. Ahora puedo ayudar a mis clientes a descubrir sus fortalezas y alcanzar sus metas. Si tuviera que resumir mi experiencia en una palabra, sería: crecimiento.'
        },
        {
          name: 'Andrea Mercedes Duperón Cruz',
          role: 'Impulso Humano Empresarial SCP',
          quote: 'Elegí la Certificación Internacional en Coaching Organizacional por su calidad académica y su prestigio a lo largo de los años. Fortaleció mi aprendizaje y mis competencias como coach. La recomiendo a directores de RRHH, directores generales y coaches.'
        },
        {
          name: 'Delia Trapero Turrent',
          role: 'Consultora independiente · México',
          quote: 'Logré certificarme como ACC gracias al acompañamiento y la mentoría constante del staff de Inspiring Talent. Es un programa pragmático, con exposición a coaches internacionales y una práctica constante que realmente hace la diferencia.'
        },
        {
          name: 'Jorge Ignacio Rivera Cortes',
          role: 'Agile Coach in Digital and Cultural Transformation',
          quote: 'Lo que comenzó como una certificación para adquirir habilidades se transformó en un recorrido de crecimiento personal y profesional. Hoy sé crear acuerdos con éxito y convertir a mis clientes en protagonistas del cambio.'
        }
      ];

      const imgs = Array.from(document.querySelectorAll('#tImages .tc-img'));
      const contentHost = document.getElementById('tContent');
      const prevBtn = document.getElementById('tPrev');
      const nextBtn = document.getElementById('tNext');
      if (!imgs.length || !contentHost) return;

      const len = data.length;
      let active = 0;
      let autoplayTimer = null;

      function layoutImages() {
        imgs.forEach((img, i) => {
          const isActive = i === active;
          const isLeft = (active - 1 + len) % len === i;
          const isRight = (active + 1) % len === i;
          if (isActive) {
            img.style.zIndex = 3; img.style.opacity = 1; img.style.pointerEvents = 'auto';
            img.style.transform = 'translateX(0) translateY(0) scale(1) rotateY(0deg)';
            img.style.filter = 'grayscale(0)';
          } else if (isLeft) {
            img.style.zIndex = 2; img.style.opacity = 1; img.style.pointerEvents = 'auto';
            img.style.transform = 'translateX(-72px) translateY(-16px) scale(.8) rotateY(18deg)';
            img.style.filter = 'grayscale(1)';
          } else if (isRight) {
            img.style.zIndex = 2; img.style.opacity = 1; img.style.pointerEvents = 'auto';
            img.style.transform = 'translateX(72px) translateY(-16px) scale(.8) rotateY(-18deg)';
            img.style.filter = 'grayscale(1)';
          } else {
            img.style.zIndex = 1; img.style.opacity = 0; img.style.pointerEvents = 'none';
            img.style.transform = 'translateX(0) translateY(0) scale(.6) rotateY(0deg)';
            img.style.filter = 'grayscale(1)';
          }
          img.style.transition = 'transform .8s cubic-bezier(.4,2,.3,1), opacity .5s, filter .4s';
        });
      }

      function renderContent() {
        const t = data[active];
        const words = t.quote.split(' ').map((w, i) =>
          `<span class="w" style="animation-delay:${(i * 0.025).toFixed(3)}s">${w}&nbsp;</span>`
        ).join('');
        contentHost.innerHTML =
          `<h3 class="tc-name">${t.name}</h3>` +
          `<p class="tc-role">${t.role}</p>` +
          `<p class="tc-quote">${words}</p>`;
      }

      function goTo(i) {
        active = ((i % len) + len) % len;
        layoutImages();
        renderContent();
      }

      function restartAutoplay() {
        if (autoplayTimer) clearInterval(autoplayTimer);
        autoplayTimer = setInterval(() => goTo(active + 1), 5000);
      }

      prevBtn.addEventListener('click', () => { goTo(active - 1); restartAutoplay(); });
      nextBtn.addEventListener('click', () => { goTo(active + 1); restartAutoplay(); });

      layoutImages();
      renderContent();
      restartAutoplay();
    })();

    /* ============================================================
       MENÚ KINÉTICO — traducido de React+GSAP a JS vanilla + GSAP
       (referencia: sterling-gate-kinetic-navigation)
       ============================================================ */
    (function () {
      const toggleBtn = document.getElementById('kineticToggle');
      const overlay = document.getElementById('kineticOverlay');
      const backdrop = document.getElementById('kineticBackdrop');
      const menu = document.getElementById('kineticMenu');
      const bgPanels = overlay.querySelectorAll('.backdrop-layer');
      const menuLinks = overlay.querySelectorAll('.kinetic-link');
      const mtP1 = document.getElementById('mtP1');
      const mtP2 = document.getElementById('mtP2');
      const mtIcon = document.getElementById('mtIcon');
      const items = overlay.querySelectorAll('.kinetic-item[data-shape]');
      const shapesHost = overlay.querySelector('.ambient-shapes');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const canHover = window.matchMedia('(hover:hover) and (pointer:fine)').matches;

      let isOpen = false;
      let hasGsap = typeof gsap !== 'undefined';

      // easing custom para el hover de las shapes, con fallback si CustomEase no cargó
      if (hasGsap) {
        try {
          if (typeof CustomEase !== 'undefined') {
            gsap.registerPlugin(CustomEase);
            CustomEase.create('main', '0.65,0.01,0.05,0.99');
          }
        } catch (e) { /* seguimos con el ease por defecto de gsap */ }
      }

      // stagger de entrada de los links: se fija una sola vez vía transition-delay CSS
      menuLinks.forEach((link, i) => { link.style.transitionDelay = (0.28 + i * 0.06) + 's'; });

      // ---- hover shapes (solo desktop con hover real) ----
      if (canHover && !reduceMotion) {
        items.forEach(item => {
          const idx = item.getAttribute('data-shape');
          const shape = shapesHost.querySelector('.bg-shape-' + idx);
          if (!shape) return;
          const els = shape.querySelectorAll('.shape-el');

          item.addEventListener('mouseenter', () => {
            shapesHost.querySelectorAll('.bg-shape').forEach(s => s.classList.remove('active'));
            shape.classList.add('active');
            if (hasGsap) {
              gsap.fromTo(els, { scale: .5, opacity: 0, rotation: -10, transformOrigin: '50% 50%' },
                { scale: 1, opacity: 1, rotation: 0, duration: .6, stagger: .08, ease: 'back.out(1.7)', overwrite: 'auto' });
            }
          });
          item.addEventListener('mouseleave', () => {
            if (hasGsap) {
              gsap.to(els, {
                scale: .8, opacity: 0, duration: .3, ease: 'power2.in', overwrite: 'auto',
                onComplete: () => shape.classList.remove('active')
              });
            } else { shape.classList.remove('active'); }
          });
        });
      }

      // Apertura/cierre: siempre por CSS (clases), 100% independiente de si GSAP cargó o no.
      function openMenu() {
        isOpen = true;
        overlay.classList.add('is-open');
        toggleBtn.classList.add('is-active');
        toggleBtn.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
      }

      function closeMenu() {
        isOpen = false;
        overlay.classList.remove('is-open');
        toggleBtn.classList.remove('is-active');
        toggleBtn.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      }

      toggleBtn.addEventListener('click', () => isOpen ? closeMenu() : openMenu());
      backdrop.addEventListener('click', closeMenu);
      window.addEventListener('keydown', (e) => { if (e.key === 'Escape' && isOpen) closeMenu(); });

      // clic en un link: si trae data-tab, activa ese servicio antes de cerrar/navegar
      overlay.querySelectorAll('.kinetic-link, .kinetic-academy-link').forEach(link => {
        link.addEventListener('click', () => {
          const tab = link.getAttribute('data-tab');
          if (tab) activateServiceTab(tab);
          closeMenu();
        });
      });
    })();
  </script>
</body>

</html>
