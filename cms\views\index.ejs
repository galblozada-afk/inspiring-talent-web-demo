<!DOCTYPE html>
<html lang="es-MX">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" type="image/png" href="/assets/img/favicon-inspiring.png">
  <link rel="apple-touch-icon" href="/assets/img/favicon-inspiring.png">
  <title>InspiringTalent® — Hacer que las cosas sucedan hace la diferencia</title>
  <meta name="description"
    content="Consultoría en desarrollo de talento: Formación, Coaching Organizacional y Evaluación de Talento para empresas en México y Estados Unidos.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Anton&family=Archivo+Black&family=Inter:wght@400;500;600;700&family=Montserrat:wght@500;600;700;800&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="/site.css">
</head>

<body>

  <div class="topbar"><%- topbarText %><% topbarLinks.forEach(function(l){ %>&nbsp;·&nbsp;<a href="<%= l.url %>" target="_blank" rel="noopener" style="color:inherit;text-decoration:underline;"><%= l.label %></a><% }) %></div>

  <header id="siteHeader">
    <script src="https://kit.fontawesome.com/237c87b42b.js" crossorigin="anonymous"></script>
    <div class="nav">
      <a href="#top" class="logo"><img src="/assets/logo-inspiringtalent.png" alt="InspiringTalent"></a>
      <div class="nav-right">
        <a href="https://wa.link/77etlj" class="phone-link"><i class="fa-brands fa-whatsapp fa-lg"></i>
          WhatsApp</a>
        <a href="/contacto" class="btn btn-primary">Agenda una consultoría</a>
        <button class="menu-toggle-btn" id="kineticToggle" aria-label="Abrir menú" aria-expanded="false">
          <span class="mt-text">
            <p id="mtP1">Menú</p>
            <p id="mtP2">Cerrar</p>
          </span>
          <span class="icon-wrap">
            <svg id="mtIcon" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M7.33333 16L7.33333 0L8.66667 0L8.66667 16L7.33333 16Z" fill="currentColor"></path>
              <path d="M16 8.66667L0 8.66667L0 7.33333L16 7.33333L16 8.66667Z" fill="currentColor"></path>
            </svg>
          </span>
        </button>
      </div>
    </div>
  </header>

  <!-- ================= MENÚ KINÉTICO FULL-SCREEN ================= -->
  <div class="kinetic-overlay" id="kineticOverlay" data-nav="closed">
    <div class="kinetic-backdrop" id="kineticBackdrop" aria-hidden="true"></div>
    <nav class="kinetic-menu" id="kineticMenu">
      <div class="kinetic-menu-bg">
        <div class="backdrop-layer first"></div>
        <div class="backdrop-layer second"></div>
        <div class="backdrop-layer third"></div>

        <div class="ambient-shapes">
          <svg class="bg-shape bg-shape-1" viewBox="0 0 400 400">
            <circle class="shape-el" cx="80" cy="120" r="40" fill="rgba(16,185,129,.16)" />
            <circle class="shape-el" cx="300" cy="80" r="60" fill="rgba(26,54,93,.22)" />
            <circle class="shape-el" cx="200" cy="300" r="80" fill="rgba(16,185,129,.10)" />
            <circle class="shape-el" cx="350" cy="280" r="30" fill="rgba(20,232,166,.18)" />
          </svg>
          <svg class="bg-shape bg-shape-2" viewBox="0 0 400 400">
            <path class="shape-el" d="M0 200 Q100 100,200 200 T400 200" stroke="rgba(16,185,129,.22)" stroke-width="50"
              fill="none" />
            <path class="shape-el" d="M0 280 Q100 180,200 280 T400 280" stroke="rgba(26,54,93,.24)" stroke-width="34"
              fill="none" />
          </svg>
          <svg class="bg-shape bg-shape-3" viewBox="0 0 400 400">
            <circle class="shape-el" cx="50" cy="50" r="8" fill="rgba(20,232,166,.42)" />
            <circle class="shape-el" cx="150" cy="50" r="8" fill="rgba(16,185,129,.4)" />
            <circle class="shape-el" cx="250" cy="50" r="8" fill="rgba(26,54,93,.4)" />
            <circle class="shape-el" cx="350" cy="50" r="8" fill="rgba(16,185,129,.4)" />
            <circle class="shape-el" cx="100" cy="150" r="12" fill="rgba(26,54,93,.35)" />
            <circle class="shape-el" cx="200" cy="150" r="12" fill="rgba(20,232,166,.35)" />
            <circle class="shape-el" cx="300" cy="150" r="12" fill="rgba(16,185,129,.35)" />
            <circle class="shape-el" cx="50" cy="250" r="10" fill="rgba(16,185,129,.4)" />
            <circle class="shape-el" cx="150" cy="250" r="10" fill="rgba(26,54,93,.4)" />
            <circle class="shape-el" cx="250" cy="250" r="10" fill="rgba(20,232,166,.42)" />
            <circle class="shape-el" cx="350" cy="250" r="10" fill="rgba(16,185,129,.4)" />
          </svg>
          <svg class="bg-shape bg-shape-4" viewBox="0 0 400 400">
            <path class="shape-el" d="M100 100 Q150 50,200 100 Q250 150,200 200 Q150 250,100 200 Q50 150,100 100"
              fill="rgba(16,185,129,.16)" />
            <path class="shape-el" d="M250 200 Q300 150,350 200 Q400 250,350 300 Q300 350,250 300 Q200 250,250 200"
              fill="rgba(26,54,93,.2)" />
          </svg>
          <svg class="bg-shape bg-shape-5" viewBox="0 0 400 400">
            <line class="shape-el" x1="0" y1="100" x2="300" y2="400" stroke="rgba(16,185,129,.2)" stroke-width="28" />
            <line class="shape-el" x1="100" y1="0" x2="400" y2="300" stroke="rgba(26,54,93,.22)" stroke-width="22" />
            <line class="shape-el" x1="200" y1="0" x2="400" y2="200" stroke="rgba(20,232,166,.22)" stroke-width="18" />
          </svg>
          <svg class="bg-shape bg-shape-6" viewBox="0 0 400 400">
            <circle class="shape-el" cx="200" cy="200" r="60" fill="none" stroke="rgba(16,185,129,.3)"
              stroke-width="10" />
            <circle class="shape-el" cx="200" cy="200" r="100" fill="none" stroke="rgba(26,54,93,.26)"
              stroke-width="8" />
            <circle class="shape-el" cx="200" cy="200" r="140" fill="none" stroke="rgba(20,232,166,.24)"
              stroke-width="6" />
          </svg>
        </div>
      </div>

      <div class="kinetic-menu-inner">
        <ul class="kinetic-list">
          <li class="kinetic-item" data-shape="1"><a href="#top" class="kinetic-link"><span
                class="kinetic-link-text">Inicio</span><span class="kinetic-link-bg"></span></a></li>
          <li class="kinetic-item" data-shape="2"><a href="/coaching-organizacional" class="kinetic-link"><span
                class="kinetic-link-text">Coaching Organizacional</span><span class="kinetic-link-bg"></span></a></li>
          <li class="kinetic-item" data-shape="3"><a href="/formacion" class="kinetic-link"><span
                class="kinetic-link-text">Formación</span><span class="kinetic-link-bg"></span></a></li>
          <li class="kinetic-item" data-shape="4"><a href="/evaluacion-de-talento" class="kinetic-link"><span
                class="kinetic-link-text">Evaluación de Talento</span><span class="kinetic-link-bg"></span></a></li>
          <li class="kinetic-item" data-shape="5"><a href="/soluciones-para-empresas" class="kinetic-link"><span
                class="kinetic-link-text">Soluciones para Empresas</span><span class="kinetic-link-bg"></span></a></li>
          <li class="kinetic-item" data-shape="6"><a href="/nosotros" class="kinetic-link"><span
                class="kinetic-link-text">Nosotros</span><span class="kinetic-link-bg"></span></a></li>
          <li class="kinetic-item" data-shape="1"><a href="/contacto" class="kinetic-link"><span
                class="kinetic-link-text">Contacto</span><span class="kinetic-link-bg"></span></a></li>
          <li class="kinetic-item" data-shape="1"><a href="/blog" class="kinetic-link"><span
                class="kinetic-link-text">Blog</span><span class="kinetic-link-bg"></span></a></li>
          <% (extraMenuPages || []).forEach(function(page, index) { %><li class="kinetic-item" data-shape="<%= ((index + 2) % 6) + 1 %>"><a href="/<%= page.slug %>" class="kinetic-link"><span class="kinetic-link-text"><%= page.menu_label || page.title %></span><span class="kinetic-link-bg"></span></a></li><% }); %>
          <li class="kinetic-academy-item"><a href="https://login.inspiringtalent.mx/" class="kinetic-academy-link" target="_blank" rel="noopener">Academia Virtual <span aria-hidden="true">↗</span></a></li>
        </ul>
      </div>
    </nav>
  </div>

  <section class="hero" id="top">
    <div class="hero-video-bg" id="heroVideoBg">
      <% if (!heroMedia.length) { %>
      <video class="is-active" src="/assets/video/hero-1.mp4" autoplay muted loop playsinline preload="auto"></video>
      <% } %>
      <% heroMedia.forEach(function(m, i){ %>
        <% if (m.type === 'video') { %>
      <video class="<%= i === 0 ? 'is-active' : '' %>" src="<%= m.url %>" <%= i === 0 ? 'autoplay' : '' %> muted loop playsinline preload="auto"></video>
        <% } else { %>
      <img class="<%= i === 0 ? 'is-active' : '' %>" src="<%= m.url %>" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:<%= i === 0 ? 1 : 0 %>;">
        <% } %>
      <% }) %>
    </div>
    <div class="wrap hero-content" data-reveal>
      <span class="eyebrow"><%= heroText.eyebrow %></span>
      <h1><%= heroText.headline_prefix %> <span class="cycle-wrap" id="cycleWord"><%= (heroText.cycle_words && heroText.cycle_words[0]) || '' %></span>
      </h1>
      <p class="lede"><%= heroText.lede %></p>
      <div class="hero-ctas">
        <a href="/contacto" class="btn btn-primary">Agenda una consultoría</a>
        <a href="#servicios" class="btn btn-ghost">Ver servicios →</a>
      </div>
    </div>
  </section>

  <!-- ================= CLIENTES ================= -->
  <section class="clients-strip" id="clientes">
    <div class="wrap hero-stats-bar">
      <div class="hero-stats">
        <div><b>20+</b><span>Años de experiencia</span></div>
        <div><b>15</b><span>Años en coaching ejecutivo y de equipos</span></div>
        <div><b>MX · US</b><span>Empresas multinacionales</span></div>
      </div>
    </div>
    <div class="wrap">
      <div class="label">Algunos de nuestros clientes</div>
      <br>
    </div>
    <div class="marquee">
      <div class="marquee-track" id="marqueeTrack">
        <span class="client-logo"><img src="/assets/img/logo_Macro.png" alt="Logo Macrotech"></span>
        <span class="client-logo"><img src="/assets/img/CPM_logo.png" alt="Logo Caja Popular Mexicana"></span>
        <span class="client-logo"><img src="/assets/img/SEMPRA_logo.png" alt="Logo Sempra"></span>
        <span class="client-logo"><img src="/assets/img/PXI_logo.png" alt="Logo PXI"></span>
        <span class="client-logo"><img src="/assets/img/Berrymex_logo.png" alt="Logo Berrymex"></span>
        <span class="client-logo"><img src="/assets/img/Donaldson_logo.png" alt="Logo Donaldson"></span>
        <span class="client-logo"><img src="/assets/img/Bunge_logo.png" alt="Logo Bunge"></span>
        <span class="client-logo"><img src="/assets/img/ASEM_logo.png" alt="Logo ASEM Emprendedores de México"></span>
        <span class="client-logo"><img src="/assets/img/Chubb_logo.png" alt="Logo Chubb"></span>
        <span class="client-logo"><img src="/assets/img/Clorox1_logo.png" alt="Logo Clorox"></span>
        <span class="client-logo"><img src="/assets/img/Continental_logo.png" alt="Logo Continental"></span>
        <span class="client-logo"><img src="/assets/img/Safran_logo.png" alt="Logo Safran"></span>
        <span class="client-logo"><img src="/assets/img/Nissan_logo.png" alt="Logo Nissan"></span>
        <span class="client-logo"><img src="/assets/img/Sunbelle_logo1.png" alt="Logo Sunbelle"></span>
      </div>
    </div>
  </section>

  <section class="section challenges" aria-labelledby="challenges-title">
    <div class="wrap">
      <div class="section-head"><span class="eyebrow">Soluciones para el momento que vive tu organización</span><h2 id="challenges-title">Elige el reto que quieres transformar</h2><p>Combinamos aprendizaje, coaching y evaluación para convertir los desafíos de talento en acciones sostenibles.</p></div>
      <div class="challenge-grid">
        <a class="challenge-card" href="/coaching-organizacional"><span>01</span><h3>Fortalecer liderazgo</h3><p>Conversaciones, decisiones y equipos capaces de liderar el cambio.</p><b>Coaching organizacional →</b></a>
        <a class="challenge-card" href="/formacion"><span>02</span><h3>Desarrollar habilidades</h3><p>Programas prácticos que conectan capacidades humanas con el trabajo real.</p><b>Formación →</b></a>
        <a class="challenge-card" href="/evaluacion-de-talento"><span>03</span><h3>Entender el talento</h3><p>Información que abre mejores conversaciones de desarrollo y desempeño.</p><b>Evaluación de talento →</b></a>
        <a class="challenge-card challenge-card--accent" href="/soluciones-para-empresas"><span>04</span><h3>Diseñar una ruta integral</h3><p>Una solución a la medida para acompañar el ciclo de talento de tu organización.</p><b>Soluciones para empresas →</b></a>
      </div>
    </div>
  </section>

  <!-- ================= PRÓXIMAS EXPERIENCIAS ================= -->
  <section class="event-spotlight" id="eventos">
    <div class="wrap">
      <div class="event-spotlight-head" data-reveal>
        <div><span class="eyebrow">Agenda Inspiring Talent</span><h2>Lo próximo<br>comienza aquí.</h2></div>
        <p>Espacios para aprender, conversar y transformar la forma en que los equipos trabajan.</p>
      </div>

      <% if (events.length) { %>
        <div class="event-carousel" data-event-carousel role="region" aria-roledescription="carrusel" aria-label="Próximos eventos">
          <div class="event-carousel-stage" aria-live="off">
            <% events.forEach(function(event, index) { %>
              <article class="event-feature event-carousel-slide <%= index === 0 ? 'is-active' : '' %>" data-event-slide aria-hidden="<%= index === 0 ? 'false' : 'true' %>">
                <div class="event-feature-image" <%= event.image ? 'style="background-image:url(\'' + event.image + '\')"' : '' %>><span class="event-image-wash"></span><div class="event-date-block"><b><%= event.event_date ? new Date(event.event_date + 'T12:00:00').toLocaleDateString('es-MX', { day: '2-digit' }) : 'PRÓX' %></b><span><%= event.event_date ? new Date(event.event_date + 'T12:00:00').toLocaleDateString('es-MX', { month: 'short' }).replace('.', '').toUpperCase() : 'EVENTO' %></span></div></div>
                <div class="event-feature-content"><span class="event-location"><%= event.location || 'Experiencia Inspiring Talent' %></span><h3><%= event.title %></h3><p><%= event.description %></p><a href="<%= event.cta_href || '/contacto' %>" class="event-cta" tabindex="<%= index === 0 ? '0' : '-1' %>"><%= event.cta_label || 'Conocer más' %> <span aria-hidden="true">→</span></a></div>
              </article>
            <% }); %>
          </div>
          <% if (events.length > 1) { %>
            <div class="event-carousel-controls" aria-label="Controles de próximos eventos">
              <button class="event-carousel-toggle" type="button" aria-label="Pausar rotación" aria-pressed="false"><span aria-hidden="true">Ⅱ</span></button>
              <button class="event-carousel-prev" type="button" aria-label="Evento anterior"><span aria-hidden="true">←</span></button>
              <div class="event-carousel-dots" role="tablist" aria-label="Seleccionar evento"><% events.forEach(function(event, index) { %><button type="button" role="tab" class="event-carousel-dot <%= index === 0 ? 'is-active' : '' %>" data-event-index="<%= index %>" aria-label="Ver evento <%= index + 1 %> de <%= events.length %>" aria-selected="<%= index === 0 ? 'true' : 'false' %>"></button><% }); %></div>
              <button class="event-carousel-next" type="button" aria-label="Siguiente evento"><span aria-hidden="true">→</span></button>
            </div>
          <% } %>
        </div>
      <% } else { %>
        <div class="event-empty" data-reveal><span>Muy pronto</span><h3>Nuevas experiencias para liderar, aprender y crecer.</h3><p>Estamos preparando la siguiente agenda de Inspiring Talent. Vuelve pronto o cuéntanos qué necesita hoy tu equipo.</p><a href="/contacto" class="event-cta">Hablemos de tu equipo <span aria-hidden="true">→</span></a></div>
      <% } %>
    </div>
  </section>

  <!-- ================= NOSOTROS ================= -->
  <section class="section nosotros" id="nosotros">
    <div class="wrap nosotros-grid">
      <div data-reveal>
        <div class="img-frame img-frame--motion"><video class="nosotros-motion" autoplay muted loop playsinline preload="metadata" poster="/assets/img/service-nosotros.png" aria-label="Motion graphic de Inspiring Talent"><source src="/assets/video/motion-nosotros.mp4" type="video/mp4"></video></div>
      </div>
      <div data-reveal>
        <span class="eyebrow" style="color:var(--navy-800)">Nosotros</span>
        <h2 style="font-size:clamp(26px,3vw,36px);color:var(--navy-950);margin:14px 0 18px;">Un equipo con experiencia
          comprobada en comportamiento humano</h2>
        <p class="body-text" style="margin-top:0;">Ofrecemos soluciones a las necesidades de las empresas en el
          desarrollo del talento de su capital humano. Nuestro compromiso es apoyar a personas y empresas en el logro de
          la eficiencia y productividad por medio del aprendizaje, promoviendo una mayor conciencia en las habilidades
          personales y profesionales para el bien propio y progreso de todos.</p>
        <p class="body-text">Somos una empresa que ofrece servicios de consultoría en desarrollo de talento dentro de
          las organizaciones, con más de 20 años de experiencia y 15 años en Coaching organizacional, ejecutivo y de
          equipos en empresas multinacionales en México y Estados Unidos.</p>
        <div class="values">
          <span class="value-chip value-chip--animated">Aprendizaje</span>
          <span class="value-chip value-chip--animated">Creatividad</span>
          <span class="value-chip value-chip--animated">Compromiso</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= POR QUÉ ELEGIRNOS ================= -->
  <section class="section tight why-choose">
    <div class="wrap why-grid">
      <div data-reveal>
        <span class="eyebrow" style="color:var(--navy-800)">¿Por qué elegirnos?</span>
        <h2 style="font-size:clamp(26px,3vw,36px);color:var(--navy-950);margin:14px 0 24px;">Resultados medibles,
          acompañamiento cercano</h2>
        <div class="why-list">
          <div class="why-item">
            <b>01</b>
            <div>
              <h4>20+ años de trayectoria</h4>
              <p>Consultoría en desarrollo de talento en empresas multinacionales de México y Estados Unidos.</p>
            </div>
          </div>
          <div class="why-item">
            <b>02</b>
            <div>
              <h4>Metodología propia</h4>
              <p>Un proceso de 5 etapas que conecta la estrategia con la implementación práctica y el seguimiento.</p>
            </div>
          </div>
          <div class="why-item">
            <b>03</b>
            <div>
              <h4>Herramientas certificadas</h4>
              <p>DISC, TriMetrix EQ, Talent Alignment y AXES-360 para decisiones basadas en datos.</p>
            </div>
          </div>
          <div class="why-item">
            <b>04</b>
            <div>
              <h4>Planes a la medida</h4>
              <p>Diseñamos cada programa según los objetivos reales de tu organización, no una plantilla genérica.</p>
            </div>
          </div>
        </div>
      </div>
      <div data-reveal>
        <div class="img-frame tall"><img class="why-airam-image" src="/assets/img/why-us-airam.png" alt="Airam Sánchez Santos, fundadora de Inspiring Talent"
            loading="lazy"></div>
      </div>
    </div>
  </section>

  <!-- ================= CITA / PUENTE ================= -->
  <section class="quote-bridge" aria-label="Una reflexión sobre el cambio">
    <div class="wrap">
      <figure class="quote-bridge-inner" data-reveal>
        <blockquote>“Cuando cambiamos la forma de mirar las cosas,<br>las cosas que miramos cambian”.</blockquote>
        <figcaption>— Wayne Dyer</figcaption>
      </figure>
    </div>
  </section>

  <!-- ================= METODOLOGÍA ================= -->
  <section class="section metodologia" id="metodologia">
    <div class="wrap">
      <div class="metodologia-head">
        <div class="section-head" data-reveal style="margin-bottom:0;">
          <span class="eyebrow">Cómo trabajamos</span>
          <h2>Nuestra metodología</h2>
          <p>Un proceso de cinco etapas que conecta la estrategia de liderazgo con resultados medibles en el día a día
            de tu organización.</p>
        </div>
        <div class="img-frame" data-reveal><img src="/assets/img/service-metodologia.png"
            alt="Sesión de formación grupal" loading="lazy"></div>
      </div>
      <div class="how-wrap" data-reveal>
        <svg class="how-path" viewBox="0 0 1000 1130" preserveAspectRatio="none" aria-hidden="true">
          <path
            d="M 290 150 C 500 150, 550 270, 710 270 C 850 270, 500 350, 290 450 C 290 600, 550 720, 750 720 C 950 720, 500 800, 290 850" />
        </svg>

        <div class="how-step how-step-1 theme-navy">
          <div class="how-card">
            <svg class="how-pin" viewBox="0 0 24 24" fill="currentColor">
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path
                d="M16 3a1 1 0 0 1 .117 1.993l-.117 .007v4.764l1.894 3.789a1 1 0 0 1 .1 .331l.006 .116v2a1 1 0 0 1 -.883 .993l-.117 .007h-4v4a1 1 0 0 1 -1.993 .117l-.007 -.117v-4h-4a1 1 0 0 1 -.993 -.883l-.007 -.117v-2a1 1 0 0 1 .06 -.34l.046 -.107l1.894 -3.791v-4.762a1 1 0 0 1 -.117 -1.993l.117 -.007h8z" />
            </svg>
            <div class="how-inner">
              <span class="how-num">01</span>
              <h4>Indagación para la generación de estrategia de liderazgo</h4>
              <p>Escuchamos a tu organización para diseñar una estrategia de liderazgo alineada a tus objetivos de
                negocio.</p>
            </div>
          </div>
        </div>

        <div class="how-step how-step-2 theme-mint">
          <div class="how-card">
            <svg class="how-pin" viewBox="0 0 24 24" fill="currentColor">
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path
                d="M16 3a1 1 0 0 1 .117 1.993l-.117 .007v4.764l1.894 3.789a1 1 0 0 1 .1 .331l.006 .116v2a1 1 0 0 1 -.883 .993l-.117 .007h-4v4a1 1 0 0 1 -1.993 .117l-.007 -.117v-4h-4a1 1 0 0 1 -.993 -.883l-.007 -.117v-2a1 1 0 0 1 .06 -.34l.046 -.107l1.894 -3.791v-4.762a1 1 0 0 1 -.117 -1.993l.117 -.007h8z" />
            </svg>
