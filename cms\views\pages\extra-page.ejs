<!DOCTYPE html><html lang="es-MX"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="icon" type="image/png" href="/assets/img/favicon-inspiring.png"><link rel="stylesheet" href="/site.css"><link rel="stylesheet" href="/extra-page.css"><title><%= page.title %> · Inspiring Talent</title></head><body><%- include('../partials/site-header') %>
<main class="extra-page extra-page--<%= page.layout %>"><section class="extra-page-hero"><div class="wrap extra-page-grid"><div><span class="eyebrow"><%= page.eyebrow || 'Inspiring Talent' %></span><h1><%= page.title %></h1><p><%= page.intro %></p><a class="btn btn-primary" href="<%= page.cta_href || '/contacto' %>"><%= page.cta_label || 'Hablemos' %> <span aria-hidden="true">→</span></a></div><div class="extra-page-image"><% if (page.image) { %><img src="<%= page.image %>" alt=""><% } else { %><div class="extra-page-placeholder">Inspiring<br>Talent</div><% } %></div></div></section><% if (page.blocks && page.blocks.length) { %><section class="extra-page-blocks"><div class="wrap"><span class="eyebrow">Ideas para avanzar</span><div class="extra-page-block-grid"><% page.blocks.forEach(function(block){ %><article><h2><%= block.title %></h2><p><%= block.text %></p></article><% }) %></div></div></section><% } %></main><%- include('../partials/site-footer') %></body></html>
