<%- include('../partials/admin-top', { pageTitle: post ? 'Editar entrada' : 'Nueva entrada', active: 'blog' }) %>
<%- include('../partials/admin-topline', { h1: post ? 'Editar entrada' : 'Nueva entrada de blog', email: email, flash: flash }) %>

<div class="card">
  <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:18px;">
    <p class="hint" style="margin:0;">Los badges son obligatorios para publicar y ayudan a encontrar cada artículo.</p>
    <a class="btn ghost small" href="/admin/blog/badges">Gestionar badges</a>
  </div>

  <form method="POST" action="<%= post ? '/admin/blog/' + post.id + '/edit' : '/admin/blog/new' %>" enctype="multipart/form-data">
    <label>Título</label>
    <input type="text" name="title" value="<%= post ? post.title : '' %>" required>

    <label>Extracto (resumen corto para la lista del blog)</label>
    <textarea name="excerpt" rows="2"><%= post ? post.excerpt : '' %></textarea>

    <label>Badges editoriales</label>
    <% if (!badges.length) { %>
      <p class="help-block">Aún no hay badges. Crea al menos uno antes de publicar esta entrada.</p>
    <% } else { %>
      <div class="blog-badge-picker">
        <% badges.forEach(function(badge){ const selected = post && post.badges.some(function(item){ return item.id === badge.id; }); %>
          <label class="blog-badge-option" style="--badge-color:<%= badge.color %>">
            <input type="checkbox" name="badge_ids" value="<%= badge.id %>" <%= selected ? 'checked' : '' %>>
            <span><%= badge.name %></span><small><%= badge.kind === 'format' ? 'Formato' : 'Tema' %></small>
          </label>
        <% }) %>
      </div>
    <% } %>

    <label>Imagen de portada</label>
    <% if (post && post.cover_image) { %><img src="<%= post.cover_image %>" style="max-width:280px;border-radius:8px;margin-bottom:8px;display:block;" alt="Portada actual"><% } %>
    <input type="file" name="cover_image" accept="image/jpeg,image/png,image/webp">

    <label>Video de YouTube (opcional)</label>
    <input type="url" name="youtube_url" value="<%= post && post.youtube_id ? 'https://www.youtube.com/watch?v=' + post.youtube_id : '' %>" placeholder="https://www.youtube.com/watch?v=...">
    <p class="help-block">Pega el enlace completo o corto de un video de YouTube. Se reproducirá dentro del artículo.</p>

    <label>Galería de imágenes (opcional)</label>
    <input type="file" name="gallery_images" accept="image/jpeg,image/png,image/webp" multiple>
    <p class="help-block">Puedes añadir hasta 12 imágenes desde este dispositivo. JPG, PNG o WebP.</p>
    <% if (post && post.gallery.length) { %>
      <div class="blog-gallery-admin">
        <% post.gallery.forEach(function(image){ %>
          <div class="blog-gallery-admin-item">
            <img src="<%= image.image %>" alt="">
            <label>Descripción alternativa<input type="text" name="gallery_alt_<%= image.id %>" value="<%= image.alt || '' %>" placeholder="Describe la imagen"></label>
            <label class="blog-gallery-remove"><input type="checkbox" name="remove_gallery_ids" value="<%= image.id %>"> Quitar</label>
          </div>
        <% }) %>
      </div>
    <% } %>

    <label>Contenido (HTML)</label>
    <textarea name="content_html" rows="16"><%= post ? post.content_html : '' %></textarea>
    <p class="help-block">Puedes usar HTML básico: &lt;p&gt;, &lt;h2&gt;, &lt;b&gt;, &lt;a&gt;, &lt;img&gt;, &lt;ul&gt;&lt;li&gt;, etc.</p>

    <label>Estado</label>
    <select name="status">
      <option value="draft" <%= (!post || post.status === 'draft') ? 'selected' : '' %>>Borrador (no visible al público)</option>
      <option value="published" <%= (post && post.status === 'published') ? 'selected' : '' %>>Publicado</option>
    </select>

    <button class="btn" type="submit" style="margin-top:18px;"><%= post ? 'Guardar cambios' : 'Crear entrada' %></button>
    <a class="btn ghost" href="/admin/blog" style="margin-top:18px;">Cancelar</a>
  </form>
</div>

<%- include('../partials/admin-bottom') %>
