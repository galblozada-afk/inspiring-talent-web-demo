<%- include('../partials/admin-top', { pageTitle: 'Badges del blog', active: 'blog' }) %>
<%- include('../partials/admin-topline', { h1: 'Badges del blog', email: email, flash: flash }) %>

<div class="admin-grid">
  <section class="card">
    <h2>Crear badge</h2>
    <p class="hint">Úsalos para temas y formatos: Liderazgo, Cultura, Video, Guía o Caso práctico.</p>
    <form method="post" action="/admin/blog/badges">
      <label>Nombre</label>
      <input name="name" required placeholder="Ej. Caso práctico">
      <label>Tipo</label>
      <select name="kind"><option value="topic">Tema</option><option value="format">Formato</option></select>
      <label>Color</label>
      <input name="color" type="color" value="#14E8A6">
      <button class="btn mint" type="submit" style="margin-top:18px;">Crear badge</button>
    </form>
  </section>

  <section class="card">
    <h2>Badges disponibles</h2>
    <% if (!badges.length) { %><p class="hint">Todavía no hay badges. Crea el primero para empezar a clasificar el contenido.</p><% } %>
    <div class="admin-badge-list">
      <% badges.forEach(function(badge){ %>
        <form class="admin-badge-row" method="post" action="/admin/blog/badges/<%= badge.id %>/edit">
          <span class="admin-badge-swatch" style="background:<%= badge.color %>"></span>
          <input name="name" value="<%= badge.name %>" aria-label="Nombre del badge">
          <select name="kind" aria-label="Tipo de badge"><option value="topic" <%= badge.kind === 'topic' ? 'selected' : '' %>>Tema</option><option value="format" <%= badge.kind === 'format' ? 'selected' : '' %>>Formato</option></select>
          <input name="color" type="color" value="<%= badge.color %>" aria-label="Color del badge">
          <button class="btn ghost small" type="submit">Guardar</button>
          <button class="btn ghost small" type="submit" formaction="/admin/blog/badges/<%= badge.id %>/delete" formmethod="post" onclick="return confirm('¿Eliminar este badge?');">Eliminar</button>
        </form>
      <% }) %>
    </div>
  </section>
</div>

<p style="margin-top:18px;"><a class="btn ghost" href="/admin/blog">← Volver a entradas</a></p>
<%- include('../partials/admin-bottom') %>
