<%- include('../partials/admin-top', { pageTitle: 'Próximos eventos', active: 'events' }) %>
<%- include('../partials/admin-topline', { h1: 'Próximos eventos', email: email, flash: flash }) %>

<div class="card">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;">
    <div><h2 style="margin:0;">Agenda Inspiring Talent</h2><p class="hint" style="margin-top:6px;">Los eventos publicados con fecha futura aparecen en la página principal.</p></div>
    <a class="btn mint" href="/admin/events/new">+ Nuevo evento</a>
  </div>
  <table style="margin-top:14px;">
    <thead><tr><th>Evento</th><th>Fecha</th><th>Estado</th><th></th></tr></thead>
    <tbody>
      <% if (!events.length) { %><tr><td colspan="4" class="hint">Aún no hay eventos. Crea el primero para mostrarlo en la página principal.</td></tr><% } %>
      <% events.forEach(function(event){ %>
        <tr>
          <td><strong><%= event.title %></strong><br><span class="hint"><%= event.location || 'Ubicación por definir' %></span></td>
          <td><%= event.event_date ? new Date(event.event_date + 'T12:00:00').toLocaleDateString('es-MX', { day: 'numeric', month: 'short', year: 'numeric' }) : 'Próximamente' %></td>
          <td><span class="status-pill <%= event.status %>"><%= event.status === 'published' ? 'Publicado' : 'Borrador' %></span></td>
          <td class="actions-cell"><a class="btn ghost small" href="/admin/events/<%= event.id %>/edit">Editar</a><form method="POST" action="/admin/events/<%= event.id %>/delete" onsubmit="return confirm('¿Eliminar este evento permanentemente?');"><button class="btn danger small" type="submit">Eliminar</button></form></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../partials/admin-bottom') %>
